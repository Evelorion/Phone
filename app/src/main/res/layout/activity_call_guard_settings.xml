<?xml version="1.0" encoding="utf-8"?>
<!--
  通话记录保护的设置页。

  版面顺序是刻意的：先说做不到什么（intro），再给开关。
  用户如果以为这功能能做到零残留，会基于错误的预期做决定。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ProgressBar
            android:id="@+id/call_guard_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/call_guard_intro"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/call_guard_permission_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/call_guard_need_permissions"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ============================ 总开关 ============================ -->
        <LinearLayout
            android:id="@+id/call_guard_enable_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/call_guard_enable"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/call_guard_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false" />
        </LinearLayout>

        <!-- ============================ 保护范围 ============================ -->
        <RadioGroup
            android:id="@+id/call_guard_scope_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/call_guard_scope_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/call_guard_scope_private"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_guard_scope_private" />

            <RadioButton
                android:id="@+id/call_guard_scope_unknown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_guard_scope_unknown" />

            <RadioButton
                android:id="@+id/call_guard_scope_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_guard_scope_all" />
        </RadioGroup>

        <TextView
            android:id="@+id/call_guard_scope_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ============================ 本机存储 ============================ -->
        <LinearLayout
            android:id="@+id/call_guard_storage_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_guard_encryption_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/call_guard_encryption_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/call_guard_stored_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/call_guard_require_screen_lock_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/call_guard_require_screen_lock"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/call_guard_require_screen_lock_desc"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/call_guard_require_screen_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/call_guard_migrate_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/call_guard_migrate"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/call_guard_migrate_desc"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================ 同步 ============================ -->
        <LinearLayout
            android:id="@+id/call_guard_sync_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_guard_sync_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/call_guard_bridge_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/call_guard_sync_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/call_guard_sync_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/call_guard_sync_now_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/call_guard_sync_now" />
        </LinearLayout>

        <!-- ====================== 残留风险，写在最后 ====================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/call_guard_caveats"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
